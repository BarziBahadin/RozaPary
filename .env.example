# Server-only Supabase values. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_secret_key
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
# Optional on Vercel; defaults to the deployment URL if omitted.
SITE_URL=http://localhost:3000
